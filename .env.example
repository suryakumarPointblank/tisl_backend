PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (Google Identity Services - Web application OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000

# API
API_URL=http://localhost:3001

# Gain LMS (gain.terumoindiaskilllab.com) - separate WordPress/MySQL site.
# Used to look up a user's real VISTA/Gain course access live. Leave unset to
# disable the lookup (VISTA/Gain buttons just won't show for anyone).
GAIN_DB_HOST=
GAIN_DB_PORT=3306
GAIN_DB_USER=
GAIN_DB_PASSWORD=
GAIN_DB_NAME=

# Mail (SendGrid SMTP relay via nodemailer)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=
MAIL_FROM=
# Testing phase: point contact inquiry notifications at a test inbox instead of the real recipient.
CONTACT_INQUIRY_NOTIFICATION_EMAIL=surya@pointblank.co.in
# Testing phase: general (non-medinfo) CTA notifications; production is tisl@terumo.co.jp.
GENERAL_INQUIRY_NOTIFICATION_EMAIL=surya@pointblank.co.in
